DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/amozeshyar
CORS_ALLOWED_ORIGINS=http://localhost:3300

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=amozeshyar-media
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1

DEFAULT_PREVIEW_SECONDS=30

ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=http://localhost:3300/checkout/callback

SENTRY_DSN=

# Developer account created in every install by `manage.py setup_site`
# (superuser, hidden from the instructor's user list).
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

# Public address of the site (links in emails/SMS, e.g. password reset)
SITE_URL=http://localhost:3300
# Email (password reset links, receipts). Empty = no email; in dev they print to the console.
# e.g. smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=no-reply@localhost
# SMS: dotted path to a provider class with send(phone, text); empty = no SMS
SMS_PROVIDER=
NOTIFICATION_CHANNELS=inbox,email,sms
PASSWORD_RESET_TIMEOUT_MINUTES=30

# Live classes. Empty secret = public meet.jit.si (calls drop after 5 minutes when embedded).
# Self-hosted Jitsi with JWT: deploy/JITSI_SETUP.md. Never commit real values.
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
